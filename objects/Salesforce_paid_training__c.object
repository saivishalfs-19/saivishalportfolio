<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <validationRules>
        <fullName>Error_message</fullName>
        <active>true</active>
        <errorConditionFormula>Overal_academic_percentage__c &gt; 0.60</errorConditionFormula>
        <errorDisplayField>Overal_academic_percentage__c</errorDisplayField>
        <errorMessage>Please enter above 60 perentage</errorMessage>
    </validationRules>
</CustomObject>
