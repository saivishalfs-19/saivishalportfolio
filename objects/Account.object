        <fullName>Account_number__c</fullName>
        <description>If phone number shoud be enter 10digits only</description>
        <label>Account number</label>
        <required>false</required>
        <trackFeedHistory>false</trackFeedHistory>
        <type>Phone</type>
    </fields>
    <fields>
